# Normaliza finais de linha no repositório.
# Sem isso, um clone no Windows (core.autocrlf=true) converte arquivos de texto
# para CRLF e comparações linha a linha passam a divergir entre máquinas.
* text=auto eol=lf

# Binários e mídias não devem sofrer conversão.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.xlsx binary
*.pdf binary
*.mp4 binary
*.csv text
